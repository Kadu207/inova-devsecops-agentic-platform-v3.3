APP_ENV=development
PROJECT_NAME=inova-devsecops-agentic-platform
TENANT_ID=inova-ti

NATS_URL=nats://nats:4222
NATS_STREAM=INOVA_TASKS
NATS_CONSUMER_PREFIX=inova
NATS_HOST_PORT=14222
NATS_MONITOR_HOST_PORT=18222

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Portas alternativas no host para coexistir com outras stacks Docker.
POSTGRES_HOST_PORT=15432
POSTGRES_DB=inova_platform
POSTGRES_USER=inova
POSTGRES_PASSWORD=inova_dev_password_change_me
DATABASE_URL=postgresql://inova:inova_dev_password_change_me@postgres:5432/inova_platform

REDIS_URL=redis://redis:6379/0
REDIS_HOST_PORT=16379
QDRANT_URL=http://qdrant:6333
QDRANT_HOST_PORT=16333
MINIO_ENDPOINT=minio:9000
MINIO_HOST_PORT=19010
MINIO_CONSOLE_HOST_PORT=19011
MINIO_ROOT_USER=inova
MINIO_ROOT_PASSWORD=inova_minio_dev_change_me

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-pro
OPENCODE_CONTAINER=opencode
OPENCODE_WORKSPACE=/workspace

SONAR_HOST_URL=
SONAR_TOKEN=
SNYK_TOKEN=
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com

GITHUB_TOKEN=
VPS_HOST=
VPS_USER=
VPS_SSH_PORT=58022

# Webhook ingress (staging) — gere secret forte; nunca use default em producao
WEBHOOK_SECRET=
WEBHOOK_LISTEN_HOST=0.0.0.0
WEBHOOK_LISTEN_PORT=8787
WEBHOOK_HOST_PORT=18787

# Staging / observabilidade (Onda 6)
WORKER_ADAPTER_MODE=auto
OBSERVABILITY_DATADOG_ENABLED=false
GRAFANA_URL=
GRAFANA_API_KEY=
GRAFANA_ADMIN_PASSWORD=inova_grafana_change_me
GRAFANA_HOST_PORT=13000

# Onda 7 — Vault / TLS (VPS hardening overlay)
VAULT_ADDR=
VAULT_CACERT=
VAULT_TOKEN=
VAULT_TOKEN_FILE=
VAULT_SECRET_PATH=inova/runtime
NATS_TLS_CA=
INOVA_SECRETS_FILE=
