# Staging — copie para .env.staging e preencha tokens reais (nao commitar)
APP_ENV=staging
PROJECT_NAME=inova-devsecops-agentic-platform
TENANT_ID=inova-ti

# integrated = exige SONAR/SNYK/DATADOG; auto = usa token se existir; stub = simulado
WORKER_ADAPTER_MODE=integrated

NATS_URL=nats://nats:4222
POSTGRES_PASSWORD=CHANGE_ME_STRONG
DATABASE_URL=postgresql://inova:CHANGE_ME_STRONG@postgres:5432/inova_platform

SONAR_HOST_URL=https://sonarcloud.io
SONAR_ORGANIZATION=
SONAR_TOKEN=
SNYK_TOKEN=
DATADOG_API_KEY=
DATADOG_SITE=us5.datadoghq.com

OBSERVABILITY_DATADOG_ENABLED=true

WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
WEBHOOK_LISTEN_HOST=0.0.0.0
WEBHOOK_LISTEN_PORT=8787

# Grafana (opcional — dashboard self-hosted)
GRAFANA_URL=http://127.0.0.1:3000
GRAFANA_API_KEY=
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

VAULT_ADDR=http://vault:8200
VAULT_SECRET_PATH=inova/runtime
NATS_TLS_CA=/app/deploy/tls/generated/ca.crt
INOVA_SECRETS_FILE=/run/inova/env
